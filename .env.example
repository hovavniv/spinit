# Required for the app to serve an authenticated page.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# No trailing slash: `.../` + `/auth/callback` produces a double slash that
# fails Supabase's exact-match Redirect URL allowlist and then falls back
# silently, with no session and no visible error.
SITE_URL=

# Two pre-created accounts for the RLS integration suite. A is the DJ that
# `npm run seed:demo` populates; B is an unrelated second DJ used as the
# "signed-in stranger" control.
TEST_USER_A_EMAIL=
TEST_USER_A_PASSWORD=
TEST_USER_B_EMAIL=
TEST_USER_B_PASSWORD=

# A THIRD account, for the partner role in the partner-access tests. It needs
# its own login because claim_partner_slot matches the invitation against the
# caller's OWN verified account email, so the partner cannot be impersonated by
# reusing A or B. The account must be email-confirmed or sign-in fails.
TEST_USER_C_EMAIL=
TEST_USER_C_PASSWORD=

# The account `npm run seed:demo` signs in as and writes demo events for.
SEED_DJ_EMAIL=
SEED_DJ_PASSWORD=
